# Mode backend (Supabase) — facultatif
#
# Si ces deux variables sont renseignées, l'application utilise Supabase
# (authentification, base de données, stockage privé des fichiers).
# Si elles sont absentes, l'application démarre automatiquement en mode
# démonstration locale (IndexedDB), sans compte ni synchronisation réelle.
#
# Ne mettez ici QUE la clé publique "anon" de Supabase. Ne placez jamais une
# clé de service ("service_role") dans le frontend.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
